---
import { Font } from 'astro:assets';
import '@/styles/tokens.css';
import '@/styles/global.css';
import { site } from '@/config/site';
import { WORLD_QUERY } from '@/scripts/world/query';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Social preview image, 1200 × 630, under public/. */
  image?: string;
  imageAlt?: string;
  /** No canonical URL (the 404, which Cloudflare serves with a 404 status, so it is never indexed). */
  noCanonical?: boolean;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  image = '/og-image.png',
  imageAlt = `${site.name}, ${site.role.charAt(0).toLowerCase()}${site.role.slice(1)}, ${site.city}.`,
  noCanonical = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
// Canonical and og:url need the real production URL, so they only render once `site` is set.
const canonical = Astro.site && !noCanonical ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social networks need an absolute image URL.
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07080B" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" href="/sitemap.xml" />

    {/* Before first paint: `js` says scripts run (still-page controls can show), and `w3d`
        says this screen gets the 3D home page (see scripts/world/query.ts). Both are set
        here so the CSS picks the layout without a flash. */}
    <script is:inline define:vars={{ query: WORLD_QUERY }}>
      const html = document.documentElement;
      html.classList.add('js');
      const world = window.matchMedia(query);
      const apply = () => html.classList.toggle('w3d', world.matches && !html.classList.contains('w3d-off'));
      apply();
      world.addEventListener('change', apply);
    </script>

    {/* Preloaded so the font loads at "High" priority. Discovered from CSS instead, it gets
        "VeryHigh", which Lighthouse's simulation counts as render-blocking. See README. */}
    <Font cssVariable="--font-archivo" preload />
    <slot name="head" />

    {
      site.analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflareToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
