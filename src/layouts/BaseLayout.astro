---
import { Font } from 'astro:assets';
import '@/styles/tokens.css';
import '@/styles/global.css';
import { site } from '@/config/site';
import { MOTION_QUERY } from '@/animations/query';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Social preview image, 1200 × 630, under public/. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  image = '/og-image.png',
  imageAlt = `${site.name}: ${site.role}. A building drawn as a software architecture.`,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
// Canonical and og:url need the real production URL, so they only render once `site` is set.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social networks need an absolute image URL.
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#efeae1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#262420" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />

    {/* Marks <html> with `motion-ok` before first paint, so the CSS picks the motion or the
        still layout without a flash. Mirrors src/animations/query.ts. `motion-off` is set
        if the animation code fails to load, and keeps the still layout for the visit.
        The theme is set here too, so a dark page never flashes light. */}
    <script is:inline define:vars={{ query: MOTION_QUERY }}>
      const motion = window.matchMedia(query);
      const html = document.documentElement;
      const apply = () => html.classList.toggle('motion-ok', motion.matches && !html.classList.contains('motion-off'));
      apply();
      motion.addEventListener('change', apply);

      // Theme: the visitor's choice if they made one (the header switch), else the system's.
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
      const storedTheme = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      const applyTheme = () => {
        const theme = storedTheme() ?? (systemDark.matches ? 'dark' : 'light');
        if (theme === 'dark') html.setAttribute('data-theme', 'dark');
        else html.removeAttribute('data-theme');
      };
      applyTheme();
      systemDark.addEventListener('change', applyTheme);
    </script>

    {/* Preloaded so the fonts load at "High" priority. Discovered from CSS instead, they get
        "VeryHigh", which Lighthouse's simulation counts as render-blocking. See README. */}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <slot name="head" />

    {
      site.analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflareToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
