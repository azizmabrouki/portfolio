---
/**
 * Pages off the board (case studies, notes, the 404): the top bar with where you are, a
 * reading column of sheets on the mat, and the contact sheet to close. The home page uses
 * BaseLayout directly.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopBar from '@/components/site/TopBar.astro';
import ContactBlock from '@/components/site/ContactBlock.astro';
import Glossary from '@/components/site/Glossary.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Where this page is: "Aziz Mabrouki / <crumb>". */
  crumb: string;
  /** The 404: no contact sheet, no canonical URL. */
  lost?: boolean;
}

const { crumb, lost = false, ...meta } = Astro.props;
---

<BaseLayout {...meta} noCanonical={lost}>
  <slot name="head" slot="head" />
  <TopBar crumb={crumb} />
  <main id="main" class="column">
    <slot />
    {
      !lost && (
        <section class="paper sheet close" aria-labelledby="contact-h">
          <ContactBlock />
        </section>
      )
    }
  </main>
  {!lost && <Glossary />}
</BaseLayout>

<style>
  .column {
    display: flex;
    flex-direction: column;
    gap: 96px;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 72px var(--gutter) 112px;
  }

  .close {
    background: var(--yellow);
  }
</style>
