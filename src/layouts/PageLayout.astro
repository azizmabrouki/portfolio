---
/**
 * Case studies, notes and the 404: the shared top bar, <main> and footer around
 * BaseLayout's <head>. The home page has its own bar and uses BaseLayout directly.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/site/Footer.astro';
import TopBar from '@/components/site/TopBar.astro';
import Glossary from '@/components/site/Glossary.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Id of the page's title, for "Back to the top". */
  top?: string;
  /** The 404: a bar that does not stick, the slim footer, no canonical URL. */
  lost?: boolean;
}

const { top, lost = false, ...meta } = Astro.props;
---

<BaseLayout {...meta} noCanonical={lost}>
  <slot name="head" slot="head" />
  <div class:list={['page', { lost }]}>
    <TopBar sticky={!lost} />
    <main id="main">
      <slot />
    </main>
    <Footer top={top} slim={lost} />
  </div>
  {!lost && <Glossary />}
</BaseLayout>

<style>
  .lost {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .lost main {
    flex: 1;
    display: flex;
    align-items: center;
  }
</style>
