---
/**
 * Site header: the name as the drawing set's title, the home page sections, and the
 * light/dark switch. `overlay` lays it over the hero on the home page so the building
 * starts at the very top; there, a compact copy slides in once the building is passed,
 * marks the section being read and offers a way back to the top.
 */
import { site } from '@/config/site';

interface Props {
  overlay?: boolean;
  /** On the home page, section links are in-page anchors; elsewhere they point to /#id. */
  home?: boolean;
}

const { overlay = false, home = false } = Astro.props;
const href = (anchor: string) => (home ? anchor : `/${anchor}`);
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="mark" href={home ? '#main' : '/'}>
    <span class="mark__code" aria-hidden="true">A / 00</span>
    <span class="mark__name">{site.shortName}</span>
  </a>
  <div class="site-header__end">
    <nav aria-label="Main">
      <ul role="list">
        {
          site.nav.map((link) => (
            <li>
              <a href={href(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* Hidden until the script below runs: without JavaScript there is nothing to switch. */}
    <button class="theme" type="button" data-theme-switch aria-pressed="false" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="7.5"></circle>
        <path class="theme__half" d="M12 4.5 A7.5 7.5 0 0 1 12 19.5 Z"></path>
      </svg>
      <span class="visually-hidden">Dark theme</span>
    </button>
  </div>
</header>

{
  overlay && (
    <div class="compact" data-compact-header hidden>
      <a class="mark" href="#main">
        <span class="mark__code" aria-hidden="true">A / 00</span>
        <span class="mark__name">{site.shortName}</span>
      </a>
      <nav aria-label="Sections">
        <ul role="list">
          {site.nav.map((link) => (
            <li>
              <a href={link.href} data-section={link.href.slice(1)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="compact__top" href="#main">
        <span aria-hidden="true">↑</span> Top
      </a>
    </div>
  )
}

<script>
  import { initCompactHeader } from '@/scripts/compactHeader';

  initCompactHeader();

  const button = document.querySelector<HTMLButtonElement>('[data-theme-switch]');
  if (button) {
    const html = document.documentElement;
    const isDark = () => html.getAttribute('data-theme') === 'dark';
    const sync = () => button.setAttribute('aria-pressed', String(isDark()));

    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      if (next === 'dark') html.setAttribute('data-theme', 'dark');
      else html.removeAttribute('data-theme');
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Private mode or blocked storage: the switch still works for this page.
      }
    });
    // The inline script in BaseLayout also follows the system setting.
    new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-2xs) var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .site-header--overlay {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
  }

  .site-header:not(.site-header--overlay) {
    border-block-end: var(--line-thin) solid var(--color-line-faint);
  }

  a {
    display: inline-block;
    padding-block: var(--space-2xs);
    text-decoration: none;
  }

  .mark {
    display: inline-flex;
    gap: var(--space-xs);
    color: var(--color-ink);
  }

  .mark__code {
    color: var(--color-structure);
  }

  .site-header__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-structure);
  }

  /* Compact header: fixed, slides down once the building is passed. */
  .compact {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-m);
    padding: 0 var(--gutter);
    border-block-end: var(--line-thin) solid var(--color-ink);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transform: translateY(-110%);
    visibility: hidden;
    transition:
      transform var(--duration-moderate) var(--ease-out),
      visibility 0s linear var(--duration-moderate);
  }

  .compact[hidden] {
    display: none;
  }

  .compact.is-shown {
    transform: none;
    visibility: visible;
    transition:
      transform var(--duration-moderate) var(--ease-out),
      visibility 0s;
  }

  .compact a[aria-current='location'] {
    color: var(--color-accent-text);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--line-strong);
  }

  .compact__top {
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .compact .mark,
    .compact__top {
      display: none;
    }
  }

  .theme {
    display: inline-grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: var(--line-thin) solid var(--color-line-faint);
    border-radius: var(--radius-round);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color var(--duration-quick) var(--ease-out);
  }

  .theme[hidden] {
    display: none;
  }

  .theme:hover {
    border-color: var(--color-ink);
  }

  .theme svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .theme__half {
    fill: currentColor;
    stroke: none;
    transform-origin: 12px 12px;
    transition: transform var(--duration-moderate) var(--ease-out);
  }

  .theme[aria-pressed='true'] .theme__half {
    transform: rotate(180deg);
  }
</style>
