---
import SectionHead from '@/components/home/SectionHead.astro';
import TitleBlock from '@/components/drawing/TitleBlock.astro';
import { site } from '@/config/site';
import { languages } from '@/config/experience';

const { email, linkedin, github, cv } = site.links;
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <SectionHead
      number="05"
      marker="Contact"
      id="contact-title"
      title="Hiring? Let’s talk."
      lead="I’m looking for a junior software engineer role where I can grow toward architecture, in Tunisia, in Europe or remote. Email is the fastest way to reach me."
    />

    {
      email && (
        <div class="contact__email">
          <p>
            <a href={`mailto:${email}`}>{email}</a>
          </p>
          <button class="button button--secondary" type="button" data-copy={email} hidden>
            Copy address
          </button>
          <span class="visually-hidden" aria-live="polite" data-copy-status></span>
        </div>
      )
    }

    <ul class="contact__links cluster" role="list">
      {linkedin && <li><a href={linkedin} rel="me">LinkedIn</a></li>}
      {github && <li><a href={github} rel="me">GitHub</a></li>}
      {cv && <li><a href={cv}>CV (PDF)</a></li>}
    </ul>

    <TitleBlock
      class="contact__block"
      fields={[
        { label: 'Based in', value: site.location },
        { label: 'Open to', value: 'Tunisia · Europe · Remote' },
        { label: 'Languages', value: languages.join(' · ') },
        { label: 'Graduating', value: 'ESPRIT, 2026' },
      ]}
    />
  </div>
</section>

<script>
  // "Copy address": shown only where the clipboard is available.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && navigator.clipboard) {
    const label = button.textContent?.trim() ?? 'Copy address';
    let timer = 0;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied to the clipboard.';
      } catch {
        button.textContent = 'Copy failed: select the address instead';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = label;
        if (status) status.textContent = '';
      }, 2400);
    });
  }
</script>

<style>
  .contact {
    padding-block-end: var(--space-3xl);
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-block-end: var(--space-m);
  }

  .contact__email p {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .contact__email button[hidden] {
    display: none;
  }

  .contact__links {
    --cluster-gap: var(--space-2xs) var(--space-l);

    margin: 0 0 var(--space-xl);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
</style>
