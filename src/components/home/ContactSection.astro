---
/**
 * "Last stop. Let's build yours.": what I'm looking for, where, how fast I reply, and the
 * ways to reach me. In the 3D world, hovering "Email me" quickens the heartbeat and lifts
 * the empty layer on top of the stack (scripts/world reads data-listen).
 */
import { contact } from '@/config/home';
import { mailto, site } from '@/config/site';
---

<section id="contact" data-sec="contact" class="wrap contact" aria-labelledby="c-title">
  <div class="ccol">
    <div class="ctext rv">
      <h2 id="c-title" class="disp h2c">
        {
          contact.lines.map((line, n) => (
            <span class="mask" style={n > 0 ? '--d: 90ms' : undefined}>
              <span>{line} </span>
            </span>
          ))
        }
      </h2>
      <p class="clede fd" style="--d: 240ms">{contact.lede}</p>
    </div>
    <div class="cpanel rv">
      <dl class="fields fd">
        {
          contact.fields.map((field, index) => (
            <div class:list={{ wide: index === 0 || index === 3 }}>
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </div>
          ))
        }
        <div class="span2">
          <dt>Works with</dt>
          <dd>{contact.worksWith.join(', ')}</dd>
        </div>
      </dl>
      <div class="cbtns fd" style="--d: 160ms">
        <a class="btn btn-gold" href={mailto()} data-listen>Email me</a>
        <div class="row2">
          {site.links.linkedin && <a class="btn btn-ghost" href={site.links.linkedin}>LinkedIn</a>}
          {site.links.github && <a class="btn btn-ghost" href={site.links.github}>GitHub</a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-top: 96px;
  }

  .ccol {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 720px;
  }

  .ctext {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .h2c {
    font-size: clamp(46px, 6vw, 100px);
  }

  .clede {
    margin: 0;
    max-width: 30em;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.5;
  }

  .cpanel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 22px 20px;
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px rgb(255 181 71 / 0.5);
  }

  .fields {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 18px;
  }

  .fields dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-faint);
  }

  .fields dd {
    margin: 4px 0 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .fields .wide,
  .fields .span2 {
    grid-column: 1 / -1;
  }

  .fields .span2 dd {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.45;
  }

  .cbtns {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .row2 {
    display: flex;
    gap: 24px;
  }

  @media (min-width: 600px) {
    .ccol {
      gap: 30px;
    }

    .ctext {
      gap: 22px;
    }

    .cpanel {
      padding: 24px;
    }

    .fields {
      gap: 16px 24px;
    }

    .fields .wide {
      grid-column: auto;
    }

    .fields dd {
      font-size: 17px;
    }

    .fields .span2 dd {
      font-size: 16px;
    }

    .cbtns {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 24px;
    }
  }

  :global(html.w3d) .contact {
    min-height: min(100vh, 1000px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 110px;
    padding-bottom: 110px;
  }

  :global(html.w3d) .ccol {
    width: min(46%, 640px);
    max-width: none;
    margin-left: auto;
  }
</style>
