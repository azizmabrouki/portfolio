---
/**
 * A strip of notes before Contact: one row per note, newest first.
 */
import type { CollectionEntry } from 'astro:content';
import { notesIntro } from '@/config/home';
import { readingMinutes, shortDate } from '@/lib/content';
import { plain } from '@/lib/rich';

interface Props {
  notes: CollectionEntry<'notes'>[];
}

const { notes } = Astro.props;
---

<section id="notes" class="wrap notes" aria-labelledby="n-title">
  <div class="ncol rv">
    <h2 id="n-title" class="nh fd">{notesIntro.heading}</h2>
    <ul class="nlist fd" style="--d: 120ms">
      {
        notes.map((note) => (
          <li>
            <a href={`/notes/${note.id}/`}>
              <span class="nt">{note.data.title}</span>
              <span class="tab yr">
                <time datetime={note.data.date.toISOString().slice(0, 10)}>{shortDate(note.data.date)}</time>
                <span class="mins"> · {readingMinutes(note.body)} min read</span>
              </span>
              <span class="ns">{plain(note.data.summary)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .notes {
    position: relative;
    padding-top: 96px;
  }

  .ncol {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
  }

  .nh {
    margin: 0;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-muted);
  }

  .nlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nlist a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur-fast);
  }

  .nlist a:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .nt {
    font-weight: 700;
    font-size: clamp(20px, 1.8vw, 26px);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .yr {
    color: var(--text-muted);
    font-size: 14px;
  }

  .ns {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  @media (min-width: 600px) {
    .nlist a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px 24px;
      align-items: baseline;
      padding: 18px 20px;
    }

    .ns {
      grid-column: 1 / -1;
      font-size: 16px;
    }

    .yr {
      font-size: 15px;
    }

    .mins {
      display: none;
    }
  }

  :global(html.w3d) .notes {
    padding-top: 140px;
  }

  :global(html.w3d) .ncol {
    gap: 18px;
    width: min(46%, 640px);
    max-width: none;
    margin-left: auto;
  }
</style>
