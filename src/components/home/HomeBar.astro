---
/**
 * The home page's top bar: the brand, a pipeline of the four sections that fills as you
 * read (wide screens), and an "Available" status with the time in Tunis. On narrow
 * screens the pipeline becomes a menu sheet. The clock and the fills come from
 * scripts/home.ts; without JavaScript the bar is the brand, the links and the status.
 */
import { stages } from '@/config/home';
import { site } from '@/config/site';
import ThemeToggle from '@/components/site/ThemeToggle.astro';
---

<header class="bar">
  <div class="wrap bar-in">
    <a class="brand" href="#top">{site.shortName}</a>
    <nav class="pipe" aria-label="Sections">
      {
        stages.map((stage, index) => (
          <>
            {index > 0 && (
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M4 2 L8 6 L4 10" fill="none" stroke="currentColor" stroke-width="1.6" />
              </svg>
            )}
            <a class="stage" data-pipe={index} data-st="todo" href={stage.href}>
              <span class="stage-top">
                <span class="sq">
                  <svg viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M2 5.2 L4.2 7.4 L8.2 2.8" fill="none" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </span>
                {stage.label}
              </span>
              <span class="track">
                <span class="fill" data-fill={index} />
              </span>
            </a>
          </>
        ))
      }
    </nav>
    <div class="bar-r">
      <a class="status" href="#contact">
        <span class="beat" data-beat aria-hidden="true"></span>
        <span>Available</span>
        <span class="tz">· <span class="city">{site.city} </span><span class="tab" data-clock></span></span>
      </a>
      <ThemeToggle />
      <button class="menu" type="button" aria-expanded="false" aria-controls="sheet" aria-label="Menu" data-menu>
        <svg class="i-open" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 7h16M3 15h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="i-close" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M5 5l12 12M17 5L5 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
  <nav id="sheet" class="sheet" aria-label="Sections" hidden>
    <ul>
      {
        [...stages.slice(0, -1), { href: '#notes', menu: 'Notes' }, ...stages.slice(-1)].map((item) => (
          <li>
            <a href={item.href}>{item.menu}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bar-bg-strong);
  }

  :global(html.w3d) .bar {
    position: fixed;
    left: 0;
    right: 0;
    background: var(--bar-bg);
    animation: fadein 800ms var(--ease-out) 1250ms both;
  }

  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    min-height: 60px;
  }

  .brand {
    text-decoration: none;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--gold);
  }

  /* ---- Pipeline ---- */

  .pipe {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    min-width: 88px;
    min-height: var(--target);
    padding: 8px 4px;
    text-decoration: none;
  }

  .stage-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
    color: var(--stage-idle);
    white-space: nowrap;
    transition: color 250ms;
  }

  .stage:hover .stage-top,
  .stage[data-st='run'] .stage-top,
  .stage[data-st='done'] .stage-top {
    color: var(--text);
  }

  .sq {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    background: var(--stage-square);
    flex: none;
    transition: background-color 250ms;
  }

  .sq {
    color: var(--bg);
  }

  .sq svg {
    width: 10px;
    height: 10px;
    opacity: 0;
    transition: opacity 200ms;
  }

  .stage[data-st='run'] .sq {
    background: var(--gold);
    animation: run 1200ms ease-in-out infinite;
  }

  .stage[data-st='done'] .sq {
    background: var(--text);
  }

  .stage[data-st='done'] .sq svg {
    opacity: 1;
  }

  .track {
    display: block;
    height: 2px;
    background: var(--track);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .stage[data-st='done'] .fill {
    background: var(--text);
  }

  .chev {
    width: 12px;
    height: 12px;
    color: var(--chevron);
    flex: none;
    margin-bottom: 9px;
  }

  /* ---- Status and menu ---- */

  .bar-r {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--target);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
    white-space: nowrap;
  }

  .status:hover {
    color: var(--gold);
  }

  .beat {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    animation: beat 1.6s ease-in-out infinite;
  }

  /* The world's heartbeat drives the dot itself. */
  :global(html.w3d) .beat {
    animation: none;
  }

  .tz {
    color: var(--text-muted);
  }

  .tz:has([data-clock]:empty) {
    display: none;
  }

  .city {
    display: none;
  }

  .menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .menu svg {
    width: 22px;
    height: 22px;
  }

  .menu[aria-expanded='true'] .i-open,
  .menu[aria-expanded='false'] .i-close {
    display: none;
  }

  :global(html.js) .menu {
    display: inline-flex;
  }

  .sheet {
    padding: 8px 20px 20px;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .sheet a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    box-shadow: inset 0 -1px 0 var(--line-faint);
  }

  .sheet a span {
    font-weight: 600;
    font-size: 13px;
    color: var(--text-faint);
  }

  /* Small phones: the clock goes first, then the status (the hero and the menu reach Contact). */
  @media (max-width: 479px) {
    .tz {
      display: none;
    }
  }

  @media (max-width: 399px) {
    .status {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .bar-in {
      min-height: var(--bar-h);
    }

    .pipe {
      display: flex;
    }

    .city {
      display: inline;
    }

    :global(html.js) .menu,
    .sheet {
      display: none;
    }
  }

  @keyframes run {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes beat {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes fadein {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
