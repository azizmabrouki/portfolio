---
/**
 * Opening of a home page section: sheet marker, heading, optional lead.
 */
import SectionMarker from '@/components/drawing/SectionMarker.astro';

interface Props {
  number: string;
  marker: string;
  id: string;
  title: string;
  lead?: string;
}

const { number, marker, id, title, lead } = Astro.props;
---

<header class="section-head">
  <SectionMarker as="p" sheet="B" number={number} title={marker} />
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead prose">{lead}</p>}
</header>

<style>
  .section-head {
    display: grid;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  h2 {
    max-inline-size: 22ch;
  }

  .lead {
    color: var(--color-ink-muted);
  }
</style>
