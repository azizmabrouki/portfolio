---
/**
 * "What I've built": an index of the four work slots, then one article per slot. In the
 * 3D world each article fills a screen in the right-hand column while its screen lands on
 * the stack; the others step back by colour, never by opacity, so they stay readable.
 * A slot links to its case study only once that page exists ("Case study soon" until then).
 */
import { work } from '@/config/work';
import { workIntro } from '@/config/home';
import { getProjects } from '@/lib/content';

const published = new Set((await getProjects()).filter((project) => !project.data.draft).map((project) => project.id));
const caseStudyOf = (project: string | undefined) => (project && published.has(project) ? `/projects/${project}/` : undefined);
---

<section id="work" data-sec="work" class="wrap work" aria-labelledby="w-title">
  <div class="wcol">
    <div class="wintro rv">
      <h2 id="w-title" class="disp h2">
        <span class="mask"><span>{workIntro.heading}</span></span>
      </h2>
      <ul class="index fd" style="--d: 200ms">
        {
          work.map((slot) => (
            <li>
              <a href={`#p-${slot.slot.toLowerCase()}`}>
                <span class="badge">{slot.slot}</span>
                <span>{slot.name}</span>
                {slot.status ? <span class="wip">{slot.status}</span> : <span class="tab yr">{slot.years}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="projs">
      {
        work.map((slot, index) => {
          const caseStudy = caseStudyOf(slot.project);
          return (
            <article id={`p-${slot.slot.toLowerCase()}`} class="proj" data-proj={index + 1} data-reveal="card">
              <div class="pin-in">
                <div class="ph">
                  <span class="badge">{slot.slot}</span>
                  <h3 class="disp h3">{slot.name}</h3>
                  {slot.status && <span class="wip">{slot.status}</span>}
                </div>
                {slot.hologram && <div class="holo-card" data-holo-card aria-hidden="true" />}
                {slot.pitchStill ? (
                  <p class="pitch">
                    <span class="in-world">{slot.pitch}</span>
                    <span class="in-still">{slot.pitchStill}</span>
                  </p>
                ) : (
                  <p class="pitch">{slot.pitch}</p>
                )}
                <dl class="facts">
                  {slot.facts.map((fact) => (
                    <div>
                      <dt>{fact.label}</dt>
                      <dd>{fact.text}</dd>
                    </div>
                  ))}
                  <div class="built">
                    <dt>Built with</dt>
                    <dd>{slot.builtWith}</dd>
                  </div>
                </dl>
                <div class="plinks">
                  {caseStudy ? (
                    <a class="btn btn-gold" href={caseStudy}>
                      Read the case study
                    </a>
                  ) : (
                    slot.project && <span class="soon">Case study soon</span>
                  )}
                  {slot.links?.map((link) => (
                    <a class="btn btn-ghost" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    padding-top: 96px;
  }

  .wcol {
    max-width: 720px;
  }

  .wintro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .h2 {
    font-size: var(--text-h2);
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: 560px;
  }

  .index a {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    min-height: 54px;
    padding: 0 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
    transition: background-color var(--dur-fast);
  }

  .index a:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  :global(html.w3d) .index .badge {
    background: var(--text);
  }

  .yr {
    color: var(--text-muted);
    font-size: 14px;
  }

  .projs {
    margin-top: 40px;
    margin-inline: calc(var(--gutter) * -1);
  }

  .proj {
    margin-top: 3px;
    padding: 28px 20px 24px;
    background: var(--surface);
  }

  .pin-in {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .ph {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .h3 {
    font-size: var(--text-h3);
  }

  /* The phone version of the HMA4Tech hologram (scripts/olive-card.ts); in the 3D world the
     top plate projects it instead. */
  .holo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-height: 0;
  }

  .holo-card :global(.ptree) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .holo-card :global(.pglow) {
    filter: drop-shadow(0 0 2px rgb(255 181 71 / 0.5));
  }

  :global(:root[data-theme='light']) .holo-card :global(.pglow) {
    filter: drop-shadow(0 0 0.6px rgb(7 8 11 / 0.9)) drop-shadow(0 0 2px rgb(255 181 71 / 0.4));
  }

  .holo-card :global(.pstate) {
    margin: 0;
    min-height: 28px;
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
  }

  .holo-card :global(.pstate span) {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .holo-card :global(.pstate b) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .holo-card[data-state='idle'] :global(.p-idle),
  .holo-card[data-state='bad'] :global(.p-bad),
  .holo-card[data-state='ok'] :global(.p-ok) {
    display: inline-flex;
  }

  .holo-card :global(.p-idle) {
    color: var(--text-faint);
  }

  .holo-card :global(.p-bad) {
    color: var(--red);
  }

  .holo-card :global(.p-bad b) {
    background: var(--red);
  }

  .holo-card :global(.p-ok) {
    color: var(--text);
  }

  .holo-card :global(.p-ok b) {
    background: var(--gold-fill);
  }

  :global(html.w3d) .holo-card {
    display: none;
  }

  .pitch {
    margin: 0;
    max-width: 30em;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.45;
  }

  .in-world {
    display: none;
  }

  :global(html.w3d) .in-world {
    display: inline;
  }

  :global(html.w3d) .in-still {
    display: none;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .facts div {
    display: grid;
    gap: 4px;
  }

  .facts dt {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-faint);
  }

  .facts dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .facts .built dd {
    color: var(--text-muted);
    font-size: 15px;
  }

  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
  }

  @media (max-width: 599px) {
    .plinks .btn-gold {
      width: 100%;
    }
  }

  @media (min-width: 600px) {
    .projs {
      margin-inline: 0;
    }

    .proj {
      padding: 32px 28px 28px;
    }

    .facts dd {
      font-size: 17px;
    }
  }

  /* ---- The 3D world: a right-hand column, one slot per screen ---- */

  :global(html.w3d) .work {
    padding-top: 0;
    padding-bottom: 160px;
  }

  :global(html.w3d) .wcol {
    width: min(40%, 560px);
    max-width: none;
    margin-left: auto;
  }

  :global(html.w3d) .wintro {
    min-height: 820px;
    justify-content: center;
    gap: 30px;
  }

  :global(html.w3d) .index a {
    gap: 16px;
    padding: 0 16px;
    font-size: 18px;
  }

  :global(html.w3d) .index a:hover {
    background: var(--surface-hover);
  }

  :global(html.w3d) .yr {
    font-size: 15px;
  }

  :global(html.w3d) .projs {
    margin: 0;
  }

  :global(html.w3d) .proj {
    min-height: min(100vh, 960px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: 96px 0 40px;
    background: none;
  }

  :global(html.w3d) .proj .badge {
    background: var(--text);
    transition: background-color 300ms;
  }

  :global(html.w3d) .proj[data-cur] .badge {
    background: var(--gold-fill);
  }

  :global(html.w3d) .proj:not([data-cur]) .h3,
  :global(html.w3d) .proj:not([data-cur]) .pitch,
  :global(html.w3d) .proj:not([data-cur]) .facts dd {
    color: var(--text-faint);
    transition: color 450ms;
  }
</style>
