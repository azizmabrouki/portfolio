---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '@/components/home/ProjectCard.astro';
import SectionHead from '@/components/home/SectionHead.astro';
import { filterSkills } from '@/config/skills';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section id="work" class="section container" aria-labelledby="work-title">
  <SectionHead
    number="01"
    marker="Selected work"
    id="work-title"
    title="Case studies"
    lead="Each one is a sheet: the context, ==the architecture drawn out==, and the decisions with what they cost."
  />

  {/* Stack filter: shown by its script; picking a skill highlights the case studies and
      roles that use it and dims the rest. */}
  <div class="filter" role="group" aria-labelledby="filter-label" data-stack-filter hidden>
    <span class="label" id="filter-label">Filter by skill</span>
    <button type="button" class="chip" data-skill="" data-label="All" aria-pressed="true">All</button>
    {
      filterSkills.map((skill) => (
        <button type="button" class="chip" data-skill={skill.id} data-label={skill.label} aria-pressed="false">
          {skill.label}
        </button>
      ))
    }
  </div>
  <p class="filter__status meta" aria-live="polite" data-stack-status></p>

  <ul class="cards" role="list">
    {
      projects.map((project) => (
        <li>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { initStackFilter } from '@/scripts/stackFilter';

  initStackFilter();
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-2xs);
  }

  .filter[hidden] {
    display: none;
  }

  .filter .label {
    margin-inline-end: var(--space-2xs);
  }

  .chip {
    min-block-size: 2.25rem;
    padding: var(--space-3xs) var(--space-xs);
    border: var(--line-thin) solid var(--color-structure);
    border-radius: var(--radius-round);
    background: transparent;
    color: var(--color-structure);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);
  }

  .chip:hover {
    background: var(--color-paper-raised);
  }

  .chip[aria-pressed='true'] {
    background: var(--color-structure);
    color: var(--color-paper);
  }

  .filter__status {
    min-block-size: 1.4em;
    margin-block-end: var(--space-m);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-l);
    margin: 0;
    padding: 0 6px 6px 0;
    list-style: none;
  }

  .cards li {
    display: grid;
  }
</style>
