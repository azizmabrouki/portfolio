---
/**
 * The client's path through StudioLabCloud: three real screens joined like a prototype flow
 * (catalogue → order → get help). On the board they are three frames joined by dashed
 * arrows; in the reading column they stack with the same steps between them.
 */
import type { CollectionEntry } from 'astro:content';
import Frame from '@/components/board/Frame.astro';
import { frames } from '@/config/board';

interface Props {
  project: CollectionEntry<'projects'>;
}

const screens = Astro.props.project.data.screens.filter((screen) => screen.src);
const [catalogue, cart, support] = screens;
const shots = [
  { frame: frames.catalogue, shot: catalogue, w: 800, h: 500 },
  { frame: frames.cart, shot: cart, w: 1600, h: 1000 },
  { frame: frames.support, shot: support, w: 1600, h: 1000 },
];
const steps = ['Order', 'Get help'];
---

<section id="clients-path" class="group path" data-stop="2" aria-labelledby="path-h">
  <h2 id="path-h" class="disp path-h">The client’s path</h2>
  <p class="path-p">Three real screens of StudioLabCloud, in French, in the order a client meets them.</p>
  {
    shots.map(
      ({ frame, shot, w, h }, index) =>
        shot && (
          <>
            {index > 0 && (
              <p class="conn" aria-hidden="true">
                <i />
                <span>{steps[index - 1]}</span>
              </p>
            )}
            <Frame frame={frame} kind="image" label={shot.caption}>
              <img src={shot.src} alt={shot.alt ?? shot.caption} width={w} height={h} loading="lazy" decoding="async" />
            </Frame>
          </>
        ),
    )
  }
  <svg class="noodles" aria-hidden="true" width="1" height="1">
    <path class="noodle" d="M2240 1330 C 2340 1330, 2330 1380, 2426 1380"></path>
    <polygon class="head" points="2440,1380 2418,1368 2418,1392"></polygon>
    <path class="noodle" d="M2920 1680 C 2920 1920, 3010 2160, 2878 2160"></path>
    <polygon class="head" points="2864,2160 2886,2148 2886,2172"></polygon>
  </svg>
  <span class="nlab" aria-hidden="true" style="--x: 2262px; --y: 1282px">{steps[0]}</span>
  <span class="nlab" aria-hidden="true" style="--x: 2948px; --y: 1902px">{steps[1]}</span>
</section>

<style>
  .path {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .path-h {
    color: var(--on-mat);
    font-size: clamp(30px, 4.4vw, 60px);
  }

  .path-p {
    margin: 10px 0 44px;
    max-width: 52ch;
    color: var(--on-mat-soft);
  }

  .path :global(.frame-image) {
    aspect-ratio: 16 / 10;
  }

  .path img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
    background: var(--paper-sunk);
  }

  .conn {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 88px;
    padding-left: clamp(24px, 6vw, 64px);
  }

  .conn i {
    width: 4px;
    height: 100%;
    background: repeating-linear-gradient(var(--yellow) 0 10px, transparent 10px 18px);
    animation: down 1s linear infinite;
  }

  .conn span,
  .nlab {
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--ink);
    font: 600 14px/1 var(--font-sans);
    white-space: nowrap;
  }

  @keyframes down {
    to {
      background-position: 0 18px;
    }
  }

  .noodles,
  .nlab {
    display: none;
  }

  /* ---- On the board: three loose frames joined by flowing arrows ---- */

  :global(html.board) .path {
    display: contents;
  }

  :global(html.board) .path-h,
  :global(html.board) .path-p {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  :global(html.board) .conn {
    display: none;
  }

  :global(html.board) .path :global(.frame-image) {
    aspect-ratio: auto;
  }

  :global(html.board) .noodles {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    max-width: none;
    height: 1px;
    overflow: visible;
  }

  :global(html.board) .nlab {
    display: block;
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: scale(calc(1 / var(--z, 1)));
    transform-origin: 0 0;
  }

  .noodle {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 4;
    stroke-dasharray: 14 10;
    animation: flow 1.1s linear infinite;
  }

  .head {
    fill: var(--yellow);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .noodle,
    .conn i {
      animation: none;
    }
  }
</style>
