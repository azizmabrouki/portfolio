---
/**
 * A case study's architecture as tiles, from the diagram in its frontmatter: the clients on
 * top, the deployable (the first group) holding its modules, and everything outside it on
 * the side. Boxes a decision is about are yellow, so the drawing and the decisions point at
 * each other. `edges` adds the list of how the parts talk.
 */
import type { CollectionEntry } from 'astro:content';

type Diagram = CollectionEntry<'projects'>['data']['diagram'];
type Decision = CollectionEntry<'projects'>['data']['decisions'][number];

interface Props {
  diagram: Diagram;
  decisions: Decision[];
  edges?: boolean;
}

const { diagram, decisions, edges = false } = Astro.props;
const group = diagram.groups?.[0];
const inside = (node: Diagram['nodes'][number]) =>
  !!group && node.x >= group.x && node.x < group.x + group.w && node.y >= group.y && node.y < group.y + group.h;
const lit = new Set([...decisions.flatMap((d) => (d.node ? [d.node] : [])), ...diagram.nodes.filter((n) => n.accent).map((n) => n.id)]);

const clients = diagram.nodes.filter((n) => n.kind === 'client');
const modules = diagram.nodes.filter((n) => n.kind !== 'client' && inside(n));
const outside = diagram.nodes.filter((n) => n.kind !== 'client' && !inside(n));
const name = (id: string) => diagram.nodes.find((n) => n.id === id)?.label ?? diagram.groups?.find((g) => g.id === id)?.label ?? id;
const talks = diagram.edges.filter((e) => e.label);
---

<figure class="sys" aria-label={diagram.alt ?? diagram.description}>
  <div class="row">
    {
      clients.map((node) => (
        <p class="tile dark">
          <b>{node.label}</b>
          {node.note}
        </p>
      ))
    }
  </div>
  <div class="split">
    {
      group && (
        <div class="app">
          <p class="app-h">{group.label}</p>
          <div class="mods">
            {modules.map((node) => (
              <p class:list={['tile', { lit: lit.has(node.id), wide: (node.w ?? 1) > 1 }]}>
                <b>{node.label}</b>
                {node.note ?? ' '}
              </p>
            ))}
          </div>
        </div>
      )
    }
    <div class="ext">
      {
        outside.map((node) => (
          <p class:list={['tile', 'soft', { lit: lit.has(node.id) }]}>
            <b>{node.label}</b>
            {node.note ?? ' '}
          </p>
        ))
      }
    </div>
  </div>
  {
    edges && talks.length > 0 && (
      <figcaption class="talks">
        <p class="talks-h">How the parts talk</p>
        <ul>
          {talks.map((edge) => (
            <li>
              {name(edge.from)} → {name(edge.to)}: {edge.label}
            </li>
          ))}
        </ul>
      </figcaption>
    )
  }
</figure>

<style>
  .sys {
    display: flex;
    flex-direction: column;
    gap: 8px;
    container-type: inline-size;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 8px;
  }

  .split {
    display: grid;
    gap: 8px;
  }

  @container (min-width: 720px) {
    .split {
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    }
  }

  .app {
    padding: 12px;
    border-radius: 8px;
    background: var(--mat);
    color: var(--on-mat);
  }

  .app-h {
    padding: 2px 2px 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .mods {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
    gap: 6px;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .ext {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
    align-content: start;
    gap: 8px;
  }

  .tile {
    padding: 11px 13px;
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.3;
  }

  .tile b {
    display: block;
    font-size: 16px;
  }

  .dark {
    background: var(--ink);
    color: var(--paper);
  }

  .soft {
    background: var(--paper-tint);
  }

  .lit {
    background: var(--yellow);
  }

  .talks {
    margin-top: 16px;
    font-size: var(--text-small);
  }

  .talks-h {
    font-weight: 700;
  }

  .talks ul {
    margin-top: 6px;
    display: grid;
    gap: 4px;
    color: var(--ink-soft);
  }
</style>
