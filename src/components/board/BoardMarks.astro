---
/**
 * What lies on the board itself, above the frames, only on html.board: the selection
 * (moved by the board script to the current stop), my comment pins, and my cursor.
 * Pins, cursor and labels keep their size on screen at any zoom (scale 1 / --z).
 */
import { pins } from '@/config/board';
---

<div class="sel" data-sel hidden aria-hidden="true">
  <i class="h tl"></i><i class="h tr"></i><i class="h bl"></i><i class="h br"></i>
  <span class="dim mono" data-dim></span>
</div>

<div class="pins" data-pins>
  {
    pins.map((pin, index) => (
      <div class="pin" data-stop={pin.stop} style={`--x: ${pin.x}px; --y: ${pin.y}px`}>
        <button type="button" class="pin-b" aria-describedby={`pin-${index}`}>
          AM
          <span class="sr-only">: a note from Aziz</span>
        </button>
        <span id={`pin-${index}`} role="tooltip" class="pin-n">
          <b>Aziz</b>
          {pin.note}
        </span>
      </div>
    ))
  }
</div>

<div class="cursor" aria-hidden="true">
  <span class="cursor-in">
    <svg viewBox="0 0 24 24"><path d="M3 2l7.5 19 2.6-7.9L21 10.5z"></path></svg>
    <span class="cursor-tag">Aziz</span>
  </span>
</div>

<style>
  .sel,
  .pins,
  .cursor {
    display: none;
  }

  :global(html.board) .pins,
  :global(html.board) .cursor {
    display: block;
  }

  :global(html.board) .sel:not([hidden]) {
    display: block;
  }

  .sel {
    position: absolute;
    z-index: 3;
    border: calc(2px / var(--z, 1)) solid var(--yellow);
    border-radius: calc(4px / var(--z, 1));
    pointer-events: none;
  }

  .sel.anim {
    animation: sel var(--dur-select) var(--ease-out) both;
  }

  @keyframes sel {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
  }

  .h {
    position: absolute;
    width: calc(11px / var(--z, 1));
    height: calc(11px / var(--z, 1));
    border: calc(2px / var(--z, 1)) solid var(--yellow);
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .tl {
    left: 0;
    top: 0;
  }

  .tr {
    left: 100%;
    top: 0;
  }

  .bl {
    left: 0;
    top: 100%;
  }

  .br {
    left: 100%;
    top: 100%;
  }

  .dim {
    position: absolute;
    left: 50%;
    top: 100%;
    padding: calc(6px / var(--z, 1)) calc(8px / var(--z, 1));
    border-radius: calc(4px / var(--z, 1));
    background: var(--yellow);
    color: var(--ink);
    font-size: calc(11px / var(--z, 1));
    line-height: 1;
    white-space: nowrap;
    transform: translate(-50%, calc(12px / var(--z, 1)));
  }

  /* Pins disappear when the board is too small on screen to read their notes. */
  :global(html.board.far) .pins {
    display: none;
  }

  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 4;
    transform: scale(calc(1 / var(--z, 1)));
    transform-origin: 0 0;
  }

  .pin-b {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 3px solid var(--paper);
    border-radius: 50% 50% 50% 6px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
    animation: ping 1.8s var(--ease-out) 3;
  }

  @keyframes ping {
    from {
      box-shadow:
        0 4px 12px rgb(0 0 0 / 0.3),
        0 0 0 0 rgb(255 210 63 / 0.75);
    }

    to {
      box-shadow:
        0 4px 12px rgb(0 0 0 / 0.3),
        0 0 0 20px rgb(255 210 63 / 0);
    }
  }

  .pin-n {
    position: absolute;
    left: 56px;
    top: 0;
    width: 270px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    font-size: 15px;
    line-height: 1.4;
    box-shadow: 0 14px 34px -8px rgb(0 0 0 / 0.55);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-6px);
    transition:
      opacity 160ms,
      transform 160ms,
      visibility 0s 160ms;
  }

  .pin-n b {
    display: block;
    margin-bottom: 3px;
    color: var(--yellow);
  }

  .pin:hover .pin-n,
  .pin-b:focus + .pin-n {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms,
      transform 240ms var(--ease-out);
  }

  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    pointer-events: none;
    animation: wander 18s var(--ease-io) infinite;
  }

  .cursor-in {
    display: flex;
    align-items: flex-start;
    transform: scale(calc(1 / var(--z, 1)));
    transform-origin: 0 0;
  }

  .cursor svg {
    flex: none;
    max-width: none;
    width: 22px;
    height: 22px;
    fill: var(--yellow);
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.3));
  }

  .cursor-tag {
    margin: 16px 0 0 -4px;
    padding: 5px 9px;
    border-radius: 2px 8px 8px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }

  /* My cursor wanders over the intro: the index, the button, the name. */
  @keyframes wander {
    0%,
    8% {
      transform: translate(905px, 236px);
    }

    25%,
    33% {
      transform: translate(160px, 628px);
    }

    50%,
    58% {
      transform: translate(1000px, 440px);
    }

    75%,
    83% {
      transform: translate(560px, 420px);
    }

    100% {
      transform: translate(905px, 236px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sel.anim,
    .pin-b {
      animation: none;
    }

    .cursor {
      animation: none;
      transform: translate(905px, 236px);
    }

    .pin-n {
      transition: none;
    }
  }
</style>
