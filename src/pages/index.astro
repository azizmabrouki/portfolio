---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import TitleBlock from '@/components/drawing/TitleBlock.astro';
import HeroSequence from '@/components/hero/HeroSequence.astro';
import { site } from '@/config/site';
---

<BaseLayout>
  <main id="main">
    <HeroSequence />

    <footer class="footer container">
      <TitleBlock
        fields={[
          { label: 'Project', value: 'Portfolio' },
          { label: 'Phase', value: '02 — Hero' },
          { label: 'Status', value: 'Motion drawn' },
          { label: 'Based', value: site.availability },
        ]}
      />
      <p><Button href="/style/" variant="text" arrow>See the drawing standards</Button></p>
    </footer>
  </main>
</BaseLayout>

<style>
  .footer {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-xl) var(--space-2xl);
  }
</style>
