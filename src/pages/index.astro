---
/**
 * The home page: one page, two ways to read it.
 * - The still page (phones, tablets held upright, reduced motion, no JavaScript): the
 *   sections in order, flat drawings, every word on the page.
 * - The 3D world (wide screens with motion): the same sections pinned over a scroll story
 *   told by a CSS 3D model (scripts/world). html.w3d, set before first paint, switches.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/site/Footer.astro';
import HomeBar from '@/components/home/HomeBar.astro';
import World from '@/components/home/World.astro';
import Hero from '@/components/home/Hero.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import SystemSection from '@/components/home/SystemSection.astro';
import BreakSection from '@/components/home/BreakSection.astro';
import WorkSection from '@/components/home/WorkSection.astro';
import RouteSection from '@/components/home/RouteSection.astro';
import NotesSection from '@/components/home/NotesSection.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { breakIt } from '@/config/home';
import { site } from '@/config/site';
import { getNotes } from '@/lib/content';

const notes = await getNotes();

// Structured data: tells search engines who the site is about.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.description,
  url: Astro.site?.href,
  email: site.links.email ? `mailto:${site.links.email}` : undefined,
  address: { '@type': 'PostalAddress', addressLocality: 'Tunis', addressCountry: 'TN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'ESPRIT' },
  sameAs: [site.links.linkedin, site.links.github].filter(Boolean),
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="home" data-home data-chaos="idle" data-tz={site.timeZone} data-heal={breakIt.healAfter}>
    <World />
    <HomeBar />
    <main id="main" class="content">
      <Hero />
      <SelectedWork />
      <SystemSection />
      <BreakSection />
      <WorkSection />
      <RouteSection />
      {notes.length > 0 && <NotesSection notes={notes.slice(0, 3)} />}
      <ContactSection />
    </main>
    <Footer top="top" />
  </div>
</BaseLayout>

<script>
  import '@/scripts/home';
</script>

<style>
  .home {
    position: relative;
  }

  .content {
    position: relative;
    padding-bottom: 96px;
  }

  :global(html.w3d) .content {
    padding-bottom: 0;
  }
</style>
