---
/**
 * Served with a real 404 status by Cloudflare (not_found_handling: "404-page").
 * The designed "missing floor" version arrives in Phase 3.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionMarker from '@/components/drawing/SectionMarker.astro';
---

<BaseLayout title="Page not found" description="This page does not exist on the drawing.">
  <main id="main" class="missing sheet-ruled">
    <div class="stack">
      <SectionMarker as="p" number="404" title="Not on the drawing" />
      <h1>This floor hasn’t been drawn.</h1>
      <p><Button href="/" variant="secondary">Back to the entrance</Button></p>
    </div>
  </main>
</BaseLayout>

<style>
  .missing {
    display: grid;
    align-content: center;
    min-block-size: 100vh;
    min-block-size: 100dvh;
    padding: var(--gutter);
  }

  .stack {
    --stack-gap: var(--space-m);

    max-inline-size: 44rem;
  }
</style>
