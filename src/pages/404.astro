---
/**
 * The 404: an empty dashed frame on the mat, the page that was never laid on the board,
 * with the ways back. Served with a real 404 status by Cloudflare (wrangler.jsonc:
 * not_found_handling).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/site/Icon.astro';
import { mailto } from '@/config/site';
import { getNotes, getProjects } from '@/lib/content';

const projects = (await getProjects()).filter((project) => !project.data.draft);
const notes = await getNotes();
const routes = [
  ...projects.map((project) => ({ label: `${project.data.title} case study`, href: `/projects/${project.id}/` })),
  ...notes.slice(0, 1).map((note) => ({ label: note.data.title, href: `/notes/${note.id}/` })),
  { label: 'Report a broken link', href: mailto('Broken link on your site') },
];
---

<PageLayout title="Page not found" description="This page isn't on the board." crumb="Page not found" lost>
  <section class="slot" aria-labelledby="lost-h">
    <p class="strip">Untitled frame<span class="mono">404</span></p>
    <div class="ghost">
      <h1 id="lost-h" class="disp title">This page isn’t on the board.</h1>
      <p class="lead">
        The link may be old, or the page moved when the site was rebuilt. Everything that exists is one frame away.
      </p>
      <a class="btn btn-yellow" href="/">Back to the board<Icon name="arrow" /></a>
      <nav class="routes" aria-labelledby="r-h">
        <h2 id="r-h">Or go straight to</h2>
        <ul>
          {
            routes.map((route) => (
              <li>
                <a class="lnk" href={route.href}>
                  {route.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</PageLayout>

<style>
  .ghost {
    min-height: 60vh;
    padding: var(--sheet-pad);
    border: 2px dashed var(--dash);
    border-radius: 3px;
    color: var(--on-mat);
  }

  .title {
    max-width: 14ch;
    font-size: clamp(44px, 7vw, 104px);
  }

  .lead {
    margin: 24px 0 32px;
    max-width: 46ch;
    color: var(--on-mat-soft);
    font-size: clamp(18px, 1.8vw, 22px);
  }

  .routes {
    margin-top: 48px;
  }

  .routes h2 {
    font-size: var(--text-body);
  }

  .routes ul {
    margin-top: 10px;
    display: grid;
    gap: 8px;
  }
</style>
