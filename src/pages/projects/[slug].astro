---
/**
 * A case study, zoomed in from its frame on the board: the overview sheet (what, my part,
 * problem and result, what I built), the client's path through real screens, the story
 * (the Markdown body), the system as tiles, the decisions with their trade-offs stuck on
 * as notes, and the next stop on the board. Drafts (frontmatter `draft: true`) get no page.
 */
import { render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import SystemTiles from '@/components/board/SystemTiles.astro';
import Icon from '@/components/site/Icon.astro';
import { stops } from '@/config/board';
import { getProjects } from '@/lib/content';
import { plain, rich } from '@/lib/rich';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((project) => !project.data.draft).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const screens = data.screens.filter((screen) => screen.src);
const steps = ['Order', 'Get help', 'Next'];
const here = stops.findIndex((stop) => stop.id === project.id);
const nextStop = here >= 0 ? stops.slice(here + 1).find((stop) => stop.id !== 'clients-path') : undefined;
// "[What I'd change with more time.]" is a placeholder: the section waits for real words.
const differently = data.differently && !data.differently.trim().startsWith('[') ? data.differently : undefined;
const turns = ['2.5deg', '-2deg', '1.5deg', '-1.5deg'];
---

<PageLayout title={data.title} description={plain(data.summary)} type="article" crumb={data.title}>
  <section class="slot" aria-labelledby="cs-title">
    <p class="strip">{data.title} / Overview<span class="mono">case study</span></p>
    <div class="paper sheet hero">
      <span class="sel" aria-hidden="true"><i class="h tl"></i><i class="h tr"></i><i class="h bl"></i><i class="h br"></i></span>
      <h1 id="cs-title" class="disp title">{data.title}</h1>
      <p class="lead" set:html={rich(data.summary)} />
      {
        data.facts.length > 0 && (
          <dl class="facts">
            {data.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        data.brief && (
          <div class="brief">
            <div>
              <h2>The problem</h2>
              <p set:html={rich(data.brief.problem)} />
            </div>
            <div>
              <h2>The result</h2>
              <p set:html={rich(data.brief.result)} />
            </div>
          </div>
        )
      }
      {
        data.contribution.length > 0 && (
          <div class="built">
            <h2>What I built</h2>
            <ul>
              {data.contribution.map((item) => (
                <li set:html={rich(item)} />
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    screens.length > 0 && (
      <section class="slot path" aria-labelledby="path-h">
        <h2 id="path-h" class="disp on-mat">
          The client’s path
        </h2>
        <p class="on-mat-p">Real screens, in French, in the order a client meets them.</p>
        <div class="screens">
          {screens.map((screen, index) => (
            <>
              {index > 0 && (
                <p class="conn" aria-hidden="true">
                  <i />
                  <span>{steps[index - 1]}</span>
                </p>
              )}
              <figure class:list={['shot', { right: index % 2 === 1 }]}>
                <p class="strip">{screen.caption.split(':')[0]}</p>
                <img
                  class="paper"
                  src={screen.src}
                  alt={screen.alt ?? screen.caption}
                  width={screen.src?.includes('catalogue') ? 800 : 1600}
                  height={screen.src?.includes('catalogue') ? 500 : 1000}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{screen.caption}</figcaption>
              </figure>
            </>
          ))}
        </div>
      </section>
    )
  }

  <section class="slot" aria-labelledby="story-h">
    <p class="strip">The story</p>
    <div class="paper sheet">
      <h2 id="story-h" class="sr-only">The story</h2>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <section class="slot" id="diagram" aria-labelledby="sys-h">
    <p class="strip">The system<span class="mono">simplified</span></p>
    <div class="paper sheet">
      <h2 id="sys-h" class="disp h2">{data.diagram.title.replace(/\.$/, '')}</h2>
      <p class="sys-p">{data.diagram.description} Yellow marks what the decisions below are about.</p>
      <div class="sys">
        <SystemTiles diagram={data.diagram} decisions={data.decisions} edges />
      </div>
    </div>
  </section>

  <section class="slot decisions" aria-labelledby="dec-h">
    <h2 id="dec-h" class="disp on-mat">
      {data.decisions.length === 1 ? 'One decision' : `${['', '', 'Two', 'Three', 'Four', 'Five'][data.decisions.length] ?? data.decisions.length} decisions`}
    </h2>
    {
      data.decisions.map((decision, index) => {
        const node = data.diagram.nodes.find((n) => n.id === decision.node);
        return (
          <article class="paper sheet decision" aria-labelledby={`d-${index}`}>
            {node && <p class="where">On the drawing: {node.label}</p>}
            <h3 id={`d-${index}`} class="disp">
              {decision.title}
            </h3>
            <aside class="trade" style={`--turn: ${turns[index % turns.length]}`} aria-label="The trade-off">
              <b>The trade-off</b>
              <p set:html={rich(decision.tradeoff)} />
            </aside>
            <dl class="dec">
              <div>
                <dt>I chose</dt>
                <dd set:html={rich(decision.chose)} />
              </div>
              <div>
                <dt>Over</dt>
                <dd set:html={rich(decision.over)} />
              </div>
              <div>
                <dt>Why</dt>
                <dd set:html={rich(decision.why)} />
              </div>
            </dl>
          </article>
        );
      })
    }
  </section>

  <section class="slot ending" aria-label="Before you go">
    <div class="ghost">
      {
        differently && (
          <>
            <h2 class="disp">What I’d do differently</h2>
            <p set:html={rich(differently)} />
          </>
        )
      }
      <h2 class="disp">Built with</h2>
      <p>{data.stack.join(', ')}</p>
    </div>
    {
      nextStop && (
        <div class="paper sheet next">
          <p>Next on the board</p>
          <p class="disp next-name">{nextStop.name}</p>
          <a class="btn" href={`/#${nextStop.id}`}>
            Fly there on the board
            <Icon name="arrow" />
          </a>
        </div>
      )
    }
  </section>
</PageLayout>

<style>
  .slot {
    position: relative;
  }

  .hero {
    position: relative;
  }

  .sel {
    position: absolute;
    inset: -7px;
    border: 2px solid var(--yellow);
    border-radius: 5px;
    pointer-events: none;
    animation: sel 520ms var(--ease-out) 200ms both;
  }

  @keyframes sel {
    from {
      opacity: 0;
      transform: scale(1.015);
    }
  }

  .h {
    position: absolute;
    width: 11px;
    height: 11px;
    border: 2px solid var(--yellow);
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .tl {
    left: 0;
    top: 0;
  }

  .tr {
    left: 100%;
    top: 0;
  }

  .bl {
    left: 0;
    top: 100%;
  }

  .br {
    left: 100%;
    top: 100%;
  }

  .title {
    font-size: clamp(52px, 9vw, 128px);
    line-height: 0.86;
  }

  .lead {
    margin-top: 24px;
    max-width: 46ch;
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.4;
  }

  .facts {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0 32px;
    border-top: 2px solid var(--ink);
  }

  .facts div {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    color: var(--ink-soft);
    font-size: 15px;
  }

  .facts dd {
    font-weight: 600;
    line-height: 1.35;
  }

  .brief {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 32px;
  }

  .brief h2,
  .built h2 {
    font-size: var(--text-body);
  }

  .brief p {
    margin-top: 6px;
  }

  .built {
    margin-top: 40px;
  }

  .built ul {
    margin-top: 10px;
    display: grid;
    gap: 10px;
  }

  .built li {
    padding-left: 24px;
    position: relative;
  }

  .built li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--yellow);
    box-shadow: 0 0 0 2px var(--ink);
  }

  .on-mat {
    color: var(--on-mat);
    font-size: clamp(36px, 4.4vw, 60px);
  }

  .on-mat-p {
    margin-top: 10px;
    color: var(--on-mat-soft);
  }

  .screens {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
  }

  .shot {
    width: min(100%, 980px);
  }

  .shot.right {
    align-self: flex-end;
  }

  .shot img {
    width: 100%;
    height: auto;
    background: var(--paper-sunk);
  }

  .shot figcaption {
    margin-top: 12px;
    color: var(--on-mat-soft);
    font-size: var(--text-small);
  }

  .conn {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 88px;
    padding-left: clamp(24px, 6vw, 64px);
  }

  .conn i {
    width: 4px;
    height: 100%;
    background: repeating-linear-gradient(var(--yellow) 0 10px, transparent 10px 18px);
    animation: down 1s linear infinite;
  }

  .conn span {
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--yellow);
    font-size: 14px;
    font-weight: 600;
  }

  @keyframes down {
    to {
      background-position: 0 18px;
    }
  }

  .h2 {
    font-size: clamp(34px, 4.4vw, 60px);
  }

  .sys-p {
    margin-top: 14px;
    max-width: 62ch;
  }

  .sys {
    margin-top: 32px;
  }

  .decisions {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .decision h3 {
    max-width: 18ch;
    margin-top: 6px;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .where {
    color: var(--ink-soft);
    font-size: 15px;
  }

  .trade {
    position: absolute;
    right: clamp(16px, 4vw, 48px);
    top: -28px;
    width: min(300px, 46%);
    padding: 20px 22px;
    background: var(--yellow);
    box-shadow: var(--shadow-note);
    transform: rotate(var(--turn));
    transition: transform 260ms var(--ease-out);
  }

  .trade:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .trade b {
    display: block;
    font: 700 19px/1.1 var(--font-display);
  }

  .trade p {
    margin-top: 8px;
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .dec {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px 40px;
  }

  .dec dt {
    font-weight: 700;
  }

  .dec dd {
    margin-top: 4px;
  }

  @media (max-width: 760px) {
    .trade {
      position: relative;
      right: auto;
      top: auto;
      width: auto;
      margin-top: 24px;
    }
  }

  .ending {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }

  .ghost {
    flex: 1 1 380px;
    min-width: 0;
    padding: var(--sheet-pad);
    border: 2px dashed var(--dash);
    border-radius: 3px;
    color: var(--on-mat);
  }

  .ghost h2 {
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .ghost h2 + p {
    margin-top: 10px;
    color: var(--on-mat-soft);
  }

  .ghost p + h2 {
    margin-top: 28px;
  }

  .next {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .next-name {
    font-size: clamp(34px, 4vw, 56px);
  }

  .next .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .sel,
    .conn i {
      animation: none;
    }

    .trade {
      transition: none;
    }

    .trade:hover {
      transform: rotate(var(--turn));
    }
  }
</style>
