---
/**
 * A case study as one drawing sheet: the 30-second brief, context and problem (Markdown
 * body), the architecture drawn from frontmatter, the key decisions with their trade-offs
 * (linked to the drawing), numbers and stack. A sheet index sticks to the top.
 */
import { render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import ArchitectureDiagram from '@/components/diagram/ArchitectureDiagram.astro';
import DimensionLine from '@/components/drawing/DimensionLine.astro';
import SectionMarker from '@/components/drawing/SectionMarker.astro';
import TitleBlock from '@/components/drawing/TitleBlock.astro';
import CaseBrief from '@/components/reading/CaseBrief.astro';
import ContentsBar from '@/components/reading/ContentsBar.astro';
import { getProjects } from '@/lib/content';
import { plain, rich } from '@/lib/rich';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, previous: projects[index - 1], next: projects[index + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'> | undefined;
  next?: CollectionEntry<'projects'> | undefined;
}

const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
const data = project.data;

// The sheet index: the Markdown body's sections, then the fixed ones.
const contents = [
  ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, label: heading.text })),
  { id: 'architecture', label: 'Architecture' },
  { id: 'decisions', label: 'Decisions' },
  ...(data.numbers.length > 0 ? [{ id: 'numbers', label: 'Numbers' }] : []),
  { id: 'stack', label: 'Stack' },
  ...(data.differently ? [{ id: 'differently', label: 'Differently' }] : []),
];

const pad = (n: number) => String(n).padStart(2, '0');
const callouts = data.decisions.flatMap((decision, index) =>
  decision.node ? [{ label: pad(index + 1), target: decision.node }] : [],
);

const fields = [
  { label: 'Role', value: data.role },
  ...(data.company ? [{ label: 'Company', value: data.company }] : []),
  { label: 'Period', value: data.period },
  { label: 'Sheet', value: `P / ${data.sheet}` },
];
---

<PageLayout title={data.title} description={plain(data.summary)} type="article">
  <article class="case container">
    <header class="case__head" style={`view-transition-name: sheet-${project.id}`}>
      <SectionMarker as="p" sheet="P" number={data.sheet} title="Case study" />
      <h1 style={`view-transition-name: title-${project.id}`}>{data.title}</h1>
      <p class="lead prose" set:html={rich(data.summary)} />
      <TitleBlock fields={fields} />
      {data.disclosure && <p class="case__disclosure annotation">{data.disclosure}</p>}
    </header>

    {
      data.brief && (
        <CaseBrief
          role={data.role}
          company={data.company}
          period={data.period}
          problem={data.brief.problem}
          result={data.brief.result}
          numbers={data.numbers}
        />
      )
    }

    <ContentsBar items={contents} />

    <div class="case__body flow prose">
      <Content />
    </div>

    <section class="case__section" aria-labelledby="architecture">
      <h2 id="architecture">Architecture</h2>
      <ArchitectureDiagram spec={data.diagram} id={`${project.id}-diagram`} callouts={callouts} />
    </section>

    <section class="case__section" aria-labelledby="decisions">
      <h2 id="decisions">Key decisions</h2>
      <ol class="decisions" role="list">
        {
          data.decisions.map((decision, index) => (
            <li
              class="decision"
              id={`decision-${pad(index + 1)}`}
              data-decision-node={decision.node}
              data-decision-label={pad(index + 1)}
            >
              <SectionMarker as="span" variant="bubble" sheet="D" number={pad(index + 1)} />
              <div class="decision__body">
                <h3>{decision.title}</h3>
                <dl>
                  <div class="decision__chose">
                    <dt>Chose</dt>
                    <dd set:html={rich(decision.chose)} />
                  </div>
                  <div>
                    <dt>Over</dt>
                    <dd set:html={rich(decision.over)} />
                  </div>
                  <div>
                    <dt>Why</dt>
                    <dd set:html={rich(decision.why)} />
                  </div>
                  <div class="decision__cost">
                    <dt>Trade-off</dt>
                    <dd set:html={rich(decision.tradeoff)} />
                  </div>
                </dl>
                {decision.node && (
                  <p>
                    <button class="button button--text decision__show" type="button" data-show-on-drawing hidden>
                      Show on the drawing <span aria-hidden="true">↑</span>
                    </button>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      data.numbers.length > 0 && (
        <section class="case__section" aria-labelledby="numbers">
          <h2 id="numbers">In numbers</h2>
          <ul class="numbers" role="list">
            {data.numbers.map((number) => (
              <li>
                <DimensionLine />
                <p class="numbers__value">{number.value}</p>
                <p class="numbers__label">{number.label}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="case__section" aria-labelledby="stack">
      <h2 id="stack">Stack</h2>
      <ul class="chips" role="list">
        {data.stack.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {
      data.differently && (
        <section class="case__section" aria-labelledby="differently">
          <h2 id="differently">What I would do differently</h2>
          <p class="prose">{data.differently}</p>
        </section>
      )
    }

    {
      data.links.length > 0 && (
        <ul class="case__links cluster" role="list">
          {data.links.map((link) => (
            <li>
              <a class="button button--secondary" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <nav class="case__nav" aria-label="Other case studies">
      {
        previous ? (
          <a href={`/projects/${previous.id}/`} rel="prev">
            <span class="label">← Previous sheet</span>
            <span>{previous.data.title}</span>
          </a>
        ) : (
          <a href="/#work">
            <span class="label">← All work</span>
            <span>Back to the case studies</span>
          </a>
        )
      }
      {
        next ? (
          <a href={`/projects/${next.id}/`} rel="next">
            <span class="label">Next sheet →</span>
            <span>{next.data.title}</span>
          </a>
        ) : (
          <a href="/#contact">
            <span class="label">Contact →</span>
            <span>Let’s talk</span>
          </a>
        )
      }
    </nav>
  </article>
</PageLayout>

<script>
  import { initDecisions } from '@/scripts/decisions';

  initDecisions();
</script>

<style>
  .case {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .case__head {
    display: grid;
    gap: var(--space-m);
  }

  h1 {
    font-size: var(--step-6);
    max-inline-size: 18ch;
  }

  .case__disclosure {
    padding-inline-start: var(--space-s);
    border-inline-start: var(--line-regular) solid var(--color-accent);
    max-inline-size: var(--measure);
  }

  .case__section {
    display: grid;
    gap: var(--space-m);
  }

  /* Anchors land below the sticky sheet index. */
  .case :global(:is(h2, h3)),
  .case__section,
  .decision {
    scroll-margin-block-start: 4.5rem;
  }

  .decisions {
    display: grid;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    align-items: start;
  }

  .decision__body {
    display: grid;
    gap: var(--space-s);
    max-inline-size: 52rem;
  }

  .decision dl {
    display: grid;
    gap: var(--line-thin);
    margin: 0;
    border: var(--line-thin) solid var(--color-ink);
    background: var(--color-ink);
  }

  .decision dl div {
    display: grid;
    gap: var(--space-3xs) var(--space-s);
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-paper-raised);
  }

  @media (min-width: 720px) {
    .decision dl div {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  .decision dt {
    padding-block-start: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-annotation);
  }

  .decision dd {
    margin: 0;
  }

  .decision__chose dd {
    font-weight: 600;
  }

  .decision__show[hidden] {
    display: none;
  }

  .decision__cost dt {
    color: var(--color-accent-text);
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .numbers li {
    display: grid;
    gap: var(--space-2xs);
  }

  .numbers__value {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .numbers__value {
    color: var(--color-accent-text);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: var(--space-3xs) var(--space-xs);
    border: var(--line-thin) solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .case__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-m);
    padding-block-start: var(--space-l);
    border-block-start: var(--line-thin) solid var(--color-ink);
  }

  .case__nav a {
    display: grid;
    gap: var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-decoration: none;
  }

  .case__nav a:last-child {
    text-align: end;
  }

  .case__nav a:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }
</style>
