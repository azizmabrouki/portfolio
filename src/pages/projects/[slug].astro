---
/**
 * The case study template: title and short facts, the numbers, the problem and the result
 * in two sentences, screens, the story (the Markdown body), the architecture drawn from
 * frontmatter, the key decisions (each can light its box in the drawing), the stack, and
 * where to go next. Drafts (frontmatter `draft: true`) get no page yet.
 */
import { render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Diagram from '@/components/case/Diagram.astro';
import { getProjects } from '@/lib/content';
import { plain, rich } from '@/lib/rich';
import { mailto } from '@/config/site';
import { work } from '@/config/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .map((project, index) => ({ project, next: projects[index + 1] ?? projects[0] }))
    .filter(({ project }) => !project.data.draft)
    .map(({ project, next }) => ({
      params: { slug: project.id },
      props: { project, next: next && next.id !== project.id ? next : undefined },
    }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'> | undefined;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const slotOf = (id: string) => work.find((slot) => slot.project === id);
const slot = slotOf(project.id);
const nextSlot = next ? slotOf(next.id) : undefined;

const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
const decisionsTitle = `${words[data.decisions.length] ?? data.decisions.length} decision${data.decisions.length === 1 ? '' : 's'}.`;
const callouts = data.decisions.flatMap((decision, index) =>
  decision.node ? [{ label: String(index + 1), target: decision.node }] : [],
);
const kicker = ['Case study', data.company, data.period].filter(Boolean).join(' · ');
---

<PageLayout title={data.title} description={plain(data.summary)} type="article" top="cs-title">
  <section class="wrap hero" aria-labelledby="cs-title">
    <p class="kick">
      {slot && <span class="badge">{slot.slot}</span>}
      <span>{kicker}</span>
    </p>
    <h1 id="cs-title" class="disp h1">{data.title}</h1>
    <p class="lede">{plain(data.summary)}</p>
    {
      data.facts.length > 0 && (
        <dl class="facts">
          {data.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </section>

  {
    data.numbers.length > 0 && (
      <section class="wrap nums" aria-label="In numbers">
        {data.numbers.map((number) => (
          <div class="num">
            <b class="tab">{number.value}</b>
            <span>{number.label}</span>
          </div>
        ))}
      </section>
    )
  }

  {
    data.brief && (
      <section class="wrap brief" aria-label="In short">
        <div>
          <p class="lbl">The problem</p>
          <p set:html={rich(data.brief.problem)} />
        </div>
        <div>
          <p class="lbl">The result</p>
          <p set:html={rich(data.brief.result)} />
        </div>
      </section>
    )
  }

  {
    data.screens.length > 0 && (
      <section class="wrap screens" aria-label="Screens">
        {data.screens.map((screen) => (
          <figure>
            {screen.src ? (
              <img class="shot" src={screen.src} alt={screen.alt ?? ''} loading="lazy" />
            ) : (
              <div class="shot">{screen.placeholder}</div>
            )}
            <figcaption>{screen.caption}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  <section class="wrap story" aria-label="The story">
    <Content />
  </section>

  <section id="diagram" class="wrap sec" aria-labelledby="d-title">
    <h2 id="d-title" class="disp h2">{data.diagram.title}</h2>
    <p class="sub">{data.diagram.description}</p>
    <Diagram diagram={data.diagram} callouts={callouts} />
  </section>

  <section class="wrap sec" aria-labelledby="dec-title">
    <h2 id="dec-title" class="disp h2">{decisionsTitle}</h2>
    <p class="sub">Each one written down as a decision record at the time, with the option it beat and the price it costs.</p>
    <div class="decs">
      {
        data.decisions.map((decision, index) => (
          <article class="dec">
            <div class="dhead">
              <span class="badge">{index + 1}</span>
              <h3>{plain(decision.title)}</h3>
              {decision.node && (
                <a class="locate" href="#diagram" data-locate={decision.node}>
                  See it in the diagram
                </a>
              )}
            </div>
            <dl class="dl">
              <div class="chose">
                <dt>Chose</dt>
                <dd>{plain(decision.chose)}</dd>
              </div>
              <div>
                <dt>Over</dt>
                <dd>{plain(decision.over)}</dd>
              </div>
              <div>
                <dt>Why</dt>
                <dd>{plain(decision.why)}</dd>
              </div>
              <div class="trade">
                <dt>Trade-off</dt>
                <dd>{plain(decision.tradeoff)}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="st-title">
    <h2 id="st-title" class="lbl st-title">Built with</h2>
    <ul class="stack">
      {data.stack.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="wrap next" aria-label="Keep reading">
    {
      next &&
        (next.data.draft ? (
          <div class="ncard">
            <span class="lbl">Next case study · soon</span>
            <span class="t">
              {nextSlot && <span class="badge">{nextSlot.slot}</span>}
              {nextSlot?.name ?? next.data.title}
            </span>
            <p>{next.data.teaser ?? plain(next.data.summary)}</p>
          </div>
        ) : (
          <a class="ncard" href={`/projects/${next.id}/`}>
            <span class="lbl">Next case study</span>
            <span class="t">
              {nextSlot && <span class="badge">{nextSlot.slot}</span>}
              {nextSlot?.name ?? next.data.title}
            </span>
            <p>{next.data.teaser ?? plain(next.data.summary)}</p>
          </a>
        ))
    }
    <div class="ncard">
      <span class="lbl">Building something like this?</span>
      <p>Tell me what you are building and I'll reply within 48 hours.</p>
      <div class="cta">
        <a class="btn btn-gold" href={mailto()}>Email me</a>
        <a class="btn btn-ghost" href="/#work">All work</a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // "See it in the diagram": scroll to the drawing and light the decision's box.
  document.querySelectorAll<HTMLAnchorElement>('[data-locate]').forEach((link) => {
    link.addEventListener('click', () => {
      const id = link.dataset.locate;
      document.querySelectorAll<HTMLElement>('[data-node]').forEach((node) => {
        node.toggleAttribute('data-on', node.dataset.node === id);
      });
    });
  });
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: 72px;
  }

  .kick {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    font-weight: 600;
    font-size: 16px;
    color: var(--text-muted);
  }

  .h1 {
    font-size: clamp(56px, 9vw, 148px);
  }

  .lede {
    margin: 0;
    max-width: 34em;
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.45;
  }

  .facts {
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 24px 32px;
    padding-top: 24px;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .facts dt,
  .dl dt {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-faint);
  }

  .facts dd {
    margin: 6px 0 0;
    font-size: 17px;
    line-height: 1.45;
  }

  .nums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 3px;
    padding-bottom: 96px;
  }

  .num {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 24px;
    background: var(--surface);
  }

  .num b {
    font-weight: 700;
    font-size: clamp(64px, 7vw, 112px);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--gold);
  }

  .num span {
    font-size: 17px;
    color: var(--text-soft);
  }

  .brief {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 48px;
    padding-bottom: 120px;
  }

  .brief div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .brief p:not(.lbl) {
    margin: 0;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
    gap: 24px;
    padding-bottom: 140px;
  }

  .screens figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    font-weight: 600;
    font-size: 16px;
    color: var(--text-faint);
    text-align: center;
    object-fit: cover;
  }

  img.shot {
    padding: 0;
  }

  .screens figcaption {
    font-size: 15px;
    color: var(--text-muted);
  }

  /* The story: each chapter's heading on the left, its paragraphs on the right. */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 18px 48px;
    align-items: start;
    padding-bottom: 140px;
  }

  .story :global(h2) {
    grid-column: 1;
    margin: 0;
    font-weight: 700;
    font-size: clamp(28px, 2.6vw, 40px);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .story :global(p) {
    grid-column: 2;
    margin: 0;
    max-width: 40em;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .story :global(h2:not(:first-child)),
  .story :global(h2:not(:first-child) + p) {
    margin-top: 54px;
  }

  .story :global(p strong) {
    color: var(--gold);
  }

  .sec {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 140px;
  }

  .h2 {
    font-size: var(--text-h2);
  }

  .sub {
    margin: 0;
    max-width: 40em;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .decs {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .dec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 20px 48px;
    padding: 32px 28px;
    background: var(--surface);
  }

  .dhead {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .dhead h3 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(26px, 2.4vw, 36px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .locate {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 600;
    font-size: 15px;
    text-underline-offset: 4px;
  }

  .dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px 32px;
    grid-column: span 2;
  }

  .dl dd {
    margin: 6px 0 0;
    font-size: 17px;
    line-height: 1.5;
  }

  .dl .chose dd {
    color: var(--text);
    font-weight: 600;
  }

  .dl .trade dt {
    color: var(--gold);
  }

  .st-title {
    font-size: 15px;
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack li {
    padding: 10px 14px;
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    font-size: 16px;
  }

  .next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 3px;
    padding-bottom: 120px;
  }

  .ncard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    transition: background-color var(--dur-fast);
  }

  a.ncard:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .ncard .t {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 700;
    font-size: clamp(28px, 3vw, 44px);
    letter-spacing: -0.02em;
  }

  .ncard p {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
  }

  @media (max-width: 700px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story :global(p) {
      grid-column: 1;
      font-size: 17px;
    }

    .story :global(h2:not(:first-child) + p) {
      margin-top: 0;
    }

    .dl {
      grid-column: auto;
    }

    .nums,
    .brief,
    .screens,
    .story,
    .sec,
    .next {
      padding-bottom: 88px;
    }

    .cta .btn-gold {
      flex: 1;
    }
  }
</style>
