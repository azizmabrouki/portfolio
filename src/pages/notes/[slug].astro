---
/**
 * A note: the title and one-line summary, then the text between a contents rail (wide
 * screens) and an aside on where the idea shows up in real work. Glossary terms in the
 * text open their definition in place (components/site/Glossary.astro). It ends with the
 * case study behind the note and a way to get in touch.
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatDate, getNotes, readingMinutes, shortDate } from '@/lib/content';
import { plain } from '@/lib/rich';
import { mailto } from '@/config/site';
import { work } from '@/config/work';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const { title, summary, date, tags, where } = note.data;
const contents = headings.filter((heading) => heading.depth === 2);
const related = note.data.related ? await getEntry('projects', note.data.related) : undefined;
const relatedLive = related && !related.data.draft ? related : undefined;
const slot = relatedLive ? work.find((item) => item.project === relatedLive.id) : undefined;
---

<PageLayout title={title} description={plain(summary)} type="article" publishedTime={date} top="note-title">
  <article aria-labelledby="note-title">
    <header class="wrap hero">
      <p class="kick">
        <span class="dot" aria-hidden="true">
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M2 3h8M2 7h8M2 11h5"></path>
          </svg>
        </span>
        <span>
          Note · <time class="tab" datetime={date.toISOString().slice(0, 10)} title={formatDate(date)}>{shortDate(date)}</time> ·
          {readingMinutes(note.body)} min read
        </span>
      </p>
      <h1 id="note-title" class="disp h1">{title}</h1>
      <p class="lede">{plain(summary)}</p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="wrap body">
      {
        contents.length > 1 && (
          <nav class="side" aria-label="In this note">
            <p class="lbl">In this note</p>
            <ol>
              {contents.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="art">
        <Content />
      </div>

      {
        where && (
          <aside class="where" aria-label="Where this shows up">
            <p class="lbl">Where this shows up</p>
            <p>{where.text}</p>
            {relatedLive || !where.href.startsWith('/projects/') ? <a href={where.href}>{where.label}</a> : null}
          </aside>
        )
      }
    </div>
  </article>

  <section class="wrap next" aria-label="Keep reading">
    {
      relatedLive && (
        <a class="ncard" href={`/projects/${relatedLive.id}/`}>
          <span class="lbl">The case study behind this note</span>
          <span class="t">
            {slot && <span class="badge">{slot.slot}</span>}
            {relatedLive.data.title}
          </span>
          <p>{relatedLive.data.teaser ?? plain(relatedLive.data.summary)}</p>
        </a>
      )
    }
    <div class="ncard">
      <span class="lbl">Weighing the same call?</span>
      <p>Tell me what you are building and I'll reply within 48 hours.</p>
      <div class="cta">
        <a class="btn btn-gold" href={mailto()}>Email me</a>
        <a class="btn btn-ghost" href="/#work">All work</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: 64px;
  }

  .kick {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    font-weight: 600;
    font-size: 16px;
    color: var(--text-muted);
  }

  .dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--gold);
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .h1 {
    font-size: clamp(48px, 7.4vw, 124px);
    max-width: 11em;
  }

  .lede {
    margin: 0;
    max-width: 30em;
    font-size: clamp(20px, 1.9vw, 27px);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags li {
    padding: 8px 12px;
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    font-size: 14px;
    color: var(--text-soft);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40em) minmax(0, 1fr);
    gap: 48px;
    padding-top: 56px;
    padding-bottom: 120px;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-self: start;
    position: sticky;
    top: 104px;
  }

  .side ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .side a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
  }

  .side a:hover {
    color: var(--gold);
  }

  /* The text, written in Markdown. */
  .art {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .art :global(p),
  .art :global(li) {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .art > :global(p:first-child) {
    font-size: clamp(21px, 1.8vw, 24px);
    line-height: 1.55;
    color: var(--text);
  }

  .art :global(h2) {
    margin: 44px 0 0;
    font-weight: 700;
    font-size: clamp(28px, 2.6vw, 40px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text);
    scroll-margin-top: 96px;
  }

  .art :global(strong) {
    color: var(--text);
  }

  /* A list of gains: each item opens with its point in bold, gold. */
  .art :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .art :global(ul li) {
    padding: 20px 22px;
    background: var(--surface);
  }

  .art :global(ul li strong) {
    display: block;
    margin-bottom: 6px;
    font-size: 20px;
    color: var(--gold);
  }

  /* A numbered list: gold badges. */
  .art :global(ol) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    counter-reset: step;
  }

  .art :global(ol li) {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    counter-increment: step;
  }

  .art :global(ol li::before) {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--gold-fill);
    color: var(--text-on-gold);
    font-weight: 800;
    font-size: 14px;
    flex: none;
  }

  /* "The short version" */
  .art :global(.short) {
    margin-top: 48px;
    padding: 32px 28px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .art :global(.short h2) {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0;
    color: var(--text-faint);
  }

  .art :global(.short p) {
    font-size: clamp(21px, 1.9vw, 26px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .where {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-self: start;
    position: sticky;
    top: 104px;
    padding: 22px 20px;
    background: var(--surface);
  }

  .where p:not(.lbl) {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .where a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 600;
    font-size: 16px;
    text-underline-offset: 4px;
  }

  .next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 3px;
    padding-bottom: 120px;
  }

  .ncard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    transition: background-color var(--dur-fast);
  }

  a.ncard:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .ncard .t {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 700;
    font-size: clamp(28px, 3vw, 44px);
    letter-spacing: -0.02em;
  }

  .ncard p {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
  }

  @media (max-width: 1100px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      display: none;
    }

    .art,
    .where {
      grid-column: 1;
    }

    .where {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .art :global(p),
    .art :global(li) {
      font-size: 17px;
    }
  }
</style>
