---
/**
 * A note: one sheet with the title, the summary and the text, a sticky note beside it on
 * where the idea shows up in real work, and the case study behind it. Glossary terms in the
 * text open their definition in place (components/site/Glossary.astro).
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/site/Icon.astro';
import { formatDate, getNotes, readingMinutes, shortDate } from '@/lib/content';
import { plain } from '@/lib/rich';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, summary, date, tags, where } = note.data;
const related = note.data.related ? await getEntry('projects', note.data.related) : undefined;
const relatedLive = related && !related.data.draft ? related : undefined;
---

<PageLayout title={title} description={plain(summary)} type="article" publishedTime={date} crumb="Notes">
  <article class="slot" aria-labelledby="note-title">
    <p class="strip">
      Note<span class="mono"
        ><time datetime={date.toISOString().slice(0, 10)} title={formatDate(date)}>{shortDate(date)}</time> · {
          readingMinutes(note.body)
        } min read</span
      >
    </p>
    <div class="paper sheet">
      <h1 id="note-title" class="disp title">{title}</h1>
      <p class="lead">{plain(summary)}</p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <div class="body">
        <div class="prose">
          <Content />
        </div>
        {
          where && (
            <aside class="where" aria-label="Where this shows up">
              <b>Where this shows up</b>
              <p>{where.text}</p>
              {(relatedLive || !where.href.startsWith('/projects/')) && (
                <a class="lnk" href={where.href}>
                  {where.label}
                </a>
              )}
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    relatedLive && (
      <section class="slot" aria-label="The case study behind this note">
        <p class="strip">The case study behind this note</p>
        <a class="paper sheet related" href={`/projects/${relatedLive.id}/`}>
          <span class="disp related-t">{relatedLive.data.title}</span>
          <span class="related-p">{relatedLive.data.teaser ?? plain(relatedLive.data.summary)}</span>
          <span class="btn">
            Read the case study
            <Icon name="arrow" />
          </span>
        </a>
      </section>
    )
  }
</PageLayout>

<style>
  .title {
    max-width: 18ch;
    font-size: clamp(40px, 6vw, 84px);
  }

  .lead {
    margin-top: 20px;
    max-width: 52ch;
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.4;
  }

  .tags {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags li {
    padding: 5px 10px;
    border-radius: 6px;
    background: var(--paper-tint);
    font-size: 14px;
    font-weight: 600;
  }

  .body {
    margin-top: 48px;
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1000px) {
    .body {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: start;
      gap: 64px;
    }

    .where {
      position: sticky;
      top: calc(var(--bar-h) + 32px);
    }
  }

  .where {
    padding: 22px;
    background: var(--yellow);
    box-shadow: var(--shadow-note);
    transform: rotate(1.5deg);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .where b {
    display: block;
    font: 700 19px/1.1 var(--font-display);
  }

  .where p {
    margin: 8px 0 12px;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
  }

  .related-t {
    font-size: clamp(36px, 5vw, 64px);
  }

  .related-p {
    max-width: 52ch;
  }

  .related .btn {
    align-self: flex-start;
  }
</style>
